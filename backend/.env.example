# Base de datos (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio
JWT_REFRESH_SECRET=otro_secreto_diferente_muy_largo_para_refresh_token
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Email (SMTP) — usa Gmail con App Password o SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=Juegos Educativos <tu@gmail.com>
ADMIN_EMAIL=admin@juegoseducativos.com

# Cloudinary (opcional para imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend
FRONTEND_URL=http://localhost:5173
